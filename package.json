{
  "name": "rhero",
  "private": true,
  "version": "1.0.0",
  "description": "RHero — office operations app for RH Aero Systems (Dubai South): cleaning rounds, pantry & stationery inventory, supply orders, requests and gate passes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:cleanup": "node scripts/e2e-cleanup.mjs",
    "gen:brand": "node scripts/gen-brand.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.1.0",
    "@supabase/supabase-js": "~2.49.4",
    "@tanstack/query-sync-storage-persister": "5.62.0",
    "@tanstack/react-query": "5.62.0",
    "@tanstack/react-query-persist-client": "5.62.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "read-excel-file": "5.8.6",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "2.1.9",
    "workbox-window": "7.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
